# Prevent execution of PHP scripts in uploads directory
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Disable handler for execution
SetHandler default-handler

# Deny access to dangerous files
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|inc|cgi|pl|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
